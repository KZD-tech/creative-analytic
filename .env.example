# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Anon / publishable key. Used for the signed-in user's own session; row-level
# security decides what that session may read.
SUPABASE_ANON_KEY=
# Service-role key. Only the account system uses it (never campaign data).
# SERVER ONLY — never prefix any of these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres schema holding the tables. Leave unset for `public`, which Supabase
# exposes to the API by default. Only set this if you moved the tables into
# their own schema — and then add that schema under
# Supabase Dashboard → Settings → API → Exposed schemas.
# SUPABASE_SCHEMA=public

# ── App ───────────────────────────────────────────────────────────────────────
# Public origin, used to build the Google sign-in redirect. Vercel is detected
# automatically; set this for any other host.
# APP_URL=https://analytics.example.com

# ── Sambungan akaun iklan (pilihan — CSV berfungsi tanpa ini) ─────────────────
# Menyulitkan token platform sebelum ia disimpan. Jana dengan:
#   openssl rand -base64 32
# Tanpa ia, butang "Sambung" tidak muncul langsung.
# Menukarnya menjadikan token sedia ada tidak boleh dibaca — pengguna perlu
# menyambung semula. Tiada data metrik hilang.
TOKEN_ENCRYPTION_KEY=

# Meta Ads — developers.facebook.com/apps → Settings → Basic
# Skop yang diminta hanyalah ads_read + business_management (baca-sahaja), dan
# tidak memerlukan App Review selagi semua pengguna ada peranan dalam app itu.
META_APP_ID=
META_APP_SECRET=
# Hanya untuk app yang menggunakan "Facebook Login for Business" (semua app
# yang dibuat melalui aliran use case Meta). Ambil dari Facebook Login for
# Business → Configurations. Tanpa ia, skrin kebenaran tidak memberi apa-apa
# permission, dan ralatnya hanya muncul kemudian sebagai senarai akaun kosong.
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v21.0

# Google Ads — developer token daripada akaun Manager (MCC) → API Center.
# Client OAuth boleh dikongsi dengan log masuk Google; hanya tambah
# /api/connect/google-ads/callback pada Authorized redirect URIs.
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=      # jatuh balik kepada GOOGLE_CLIENT_ID
# GOOGLE_ADS_CLIENT_SECRET=  # jatuh balik kepada GOOGLE_CLIENT_SECRET
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # id MCC, angka sahaja, hanya jika berkenaan
