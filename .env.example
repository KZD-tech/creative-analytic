# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres schema that holds the creative-analytics tables.
# Must be listed under Supabase Dashboard → Settings → API → Exposed schemas.
SUPABASE_SCHEMA=creative

# ── App gate ──────────────────────────────────────────────────────────────────
# Optional shared password. Leave blank to run the dashboard open (local dev only).
APP_PASSWORD=
# Random string used to sign the session cookie. Generate: openssl rand -base64 32
APP_SESSION_SECRET=

# ── Meta Marketing API (Fasa 2 — belum aktif) ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
